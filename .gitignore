node_modules/
.venv/
__pycache__/
.DS_Store
*.log
/tmp/
tests/_*.mjs
.npm/
.pki/
.config/
.sudo_as_admin_successful
.ssh/

# dados locais de execução (contas, projectos, chaves)
.data/

# artefactos de execução locais
.cache/
.ms-playwright/

# bibliotecas de sistema extraídas sem root para o Chromium (tools/setup-ui-env.sh)
.local/lib/

# dados de língua do OCR: os de execução nunca são versionados...
*.traineddata
*.traineddata.gz
# ...mas a cópia de referência em vendor/ocr É versionada (é o que faz o OCR
# funcionar num serviço onde não se pode mexer em variáveis de ambiente).
!vendor/ocr/*.traineddata.gz
!vendor/ocr/manifest.json
